# ─── Railway / production env (copy to Railway Variables) ─────────────────

# Postgres connection (required for accounts, encrypted keys, /u/:token manifests)
DATABASE_URL=postgresql://user:pass@host:5432/db

# AES-256-GCM master key — 32 random bytes, base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENC_KEY=

# Invite-only signups (recommended for production). Omit or set 1 to allow public register.
ALLOW_PUBLIC_REGISTER=0

# PayPal billing (optional)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_ENV=sandbox
# Required when PayPal is enabled — webhooks are rejected without it
PAYPAL_WEBHOOK_ID=

# Runtime
NODE_ENV=production
PORT=7000
DATA_DIR=./data